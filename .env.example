# URL pública do site (canonical, Open Graph, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://julianadinizesg.com.br

# "true" em staging: robots Disallow, meta noindex e header X-Robots-Tag.
NEXT_PUBLIC_NOINDEX=false

# ID do projeto Microsoft Clarity. Vazio = nenhum script de análise é carregado.
# Com ID, o script só roda depois do "Aceitar" no banner de cookies.
NEXT_PUBLIC_CLARITY_ID=
