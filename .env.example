# URL pública do site (canonical, Open Graph, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.judiniz.com.br

# "true" em staging: robots Disallow, meta noindex e header X-Robots-Tag.
NEXT_PUBLIC_NOINDEX=false

# ID do projeto Microsoft Clarity. Se não definido, vale o padrão de lib/site.ts (z0p0bccxsr); definido e vazio = nenhum script.
# O script só roda depois do "Aceitar" no banner de cookies.
NEXT_PUBLIC_CLARITY_ID=z0p0bccxsr
